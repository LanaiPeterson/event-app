# ─── Ticketmaster Discovery API ────────────────────────────────────────────────
# Free tier: 5,000 calls/day — covers concerts, sports, arts, comedy, family events
# Sign up at: https://developer.ticketmaster.com/
# After registering, create an app and copy your "Consumer Key" here.
#
# Steps:
#   1. Go to https://developer.ticketmaster.com/ → Sign Up
#   2. Click "My Apps" → Create a new app
#   3. Copy the "Consumer Key" value
#   4. Paste it below (remove the placeholder text)
#
VITE_TICKETMASTER_KEY=your_ticketmaster_consumer_key_here

# ─── Google Maps / Places API (New) ─────────────────────────────────────────────
# Used for the "Places" page: finds museums, zoos, amusement parks, theaters, etc.
# Free tier: $200/month credit (plenty for development)
#
# Steps:
#   1. Go to https://console.cloud.google.com/ → Create a project
#   2. Enable "Places API (New)" in APIs & Services → Library
#   3. Create credentials → API key
#   4. (Optional) Restrict the key to "Places API (New)" for safety
#   5. Paste it below
#
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ─── Anthropic API (AI Itinerary Planner) ────────────────────────────────────
# Powers the AI day-planner at /itinerary. Free tier included.
#
# Steps:
#   1. Go to https://console.anthropic.com/ → Sign up / Log in
#   2. Click "API Keys" → Create a new key
#   3. Paste it below
#
VITE_ANTHROPIC_KEY=your_anthropic_key_here
